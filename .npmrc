# marked-terminal@7 still declares `marked < 16`, but marked 18 dropped the
# renderer hook it needs only partially (code-block colouring). Its hooks that
# we rely on work, so install with peer checks relaxed instead of pinning marked
# back a major.
legacy-peer-deps=true

# GitHub release downloads for the Electron binary are unreliable here.
electron_mirror=https://npmmirror.com/mirrors/electron/
