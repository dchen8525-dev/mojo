{
  "name": "node-agent",
  "version": "0.1.0",
  "description": "A Claude Code-like AI agent built with Node.js + TypeScript",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent": "./dist/cli.js"
  },
  "main": "dist/gui/electron/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-gui.mjs",
    "lint": "tsc --noEmit && node --check src/gui/static/app.js && node --check scripts/copy-gui.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "gui": "npm run build && electron .",
    "gui:browser": "npm run build && node dist/cli.js --gui",
    "icon": "electron scripts/make-icon.cjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dompurify": "^3.4.17",
    "glob": "^13.0.6",
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "jimp": "^1.6.1",
    "marked": "^18.1.1",
    "marked-terminal": "^7.3.0",
    "openai": "^7.10.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "electron": "^44.3.0",
    "happy-dom": "^21.0.4",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
